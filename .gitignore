*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.ancestor
pom.xml.versionsBackup
release.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

