# ==========================================
# Comprehensive & Universal .gitignore
# ==========================================

# ------------------------------------------
# Operating System / Environment Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------
# Editors, IDEs, and Tooling
# ------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# JetBrains / IntelliJ / PyCharm / WebStorm
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.classpath
.project
.settings/
.factorypath

# Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*~
#*#
.#*

# Visual Studio / Visual Studio Code / MSBuild
.vs/
[Dd]ebug/
[Dd]ebugPublic/
[R3]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Xcode / Apple
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcworkspace
!default.xcworkspace

# ------------------------------------------
# Secrets, Environment Variables & Keys
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.crt
*.key
*.pub
*.p12
*.pfx
*.asc
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519

# ------------------------------------------
# Node.js / JavaScript / TypeScript
# ------------------------------------------
node_modules/
jspm_packages/
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-store/
.next/
.nuxt/
.vuepress/dist
.output/
.svelte-kit/
.astro/
dist/
build/
out/
.parcel-cache/
.turbo/

# ------------------------------------------
# Python
