__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
PYTHONPATH
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
poetry.lock
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

